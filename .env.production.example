APP_NAME=CourierPortal
APP_ENV=production
APP_KEY=                          # ← generate with: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://yourcourierdomain.com
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=                          # ← RDS endpoint from AWS console (e.g. courierportal.xxxxxxxxx.ap-south-1.rds.amazonaws.com)
DB_PORT=3306
DB_DATABASE=courier_portal
DB_USERNAME=courierportal_user
DB_PASSWORD=                      # ← strong password set in RDS

CACHE_STORE=file
CACHE_PREFIX=courierportal_

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
FILESYSTEM_DISK=s3

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=ayanchoudhary76@gmail.com
MAIL_PASSWORD=                    # ← Gmail App Password
MAIL_FROM_ADDRESS=ayanchoudhary76@gmail.com
MAIL_FROM_NAME="CourierPortal"

AWS_ACCESS_KEY_ID=                # ← from AWS IAM user
AWS_SECRET_ACCESS_KEY=            # ← from AWS IAM user
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=                       # ← S3 bucket name you create
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE2FA_ENABLED=true

RAZORPAY_KEY=your_razorpay_key_here
RAZORPAY_SECRET=your_razorpay_secret_here
